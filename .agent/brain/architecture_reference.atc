[Brain: Fireball-Architecture-Reference]
[Purpose]
  - Serve as the Authoritative Source of Architectural Constraints (ASAC)
  - Collapse cognitive superposition by providing definitive modal logic constraints
  - Direct mapping from Component Concepts to TLA+ Verifiable Properties

[Canon-Architecture]
  @tier1(Architecture Domain) := {HAL, IPC_Router}
  @tier2(Subsystem Domain)    := {Memory_Manager, JIT_Compiler, COOS, Services}
  @tier3(Implementation)      := {Scheduler, Interpreter, Loader, Debugger, vMMIO}

[Global-Invariants]
  □ Design Truth := docs/specifications
  □ Interface Truth := WIT
  □ ∀c ∈ Tier2 : matches_contract(c, harness_pattern) ∧ is_pure_static(c)
  □ ∀m ∈ Allocations : ¬dynamic(m) ∧ is_heap_less(m)
  □ ∀access ∈ HostGuestBoundary : mediated_by(access) == vMMIO_permission_table

[Component-ATC]

  [IPC-Router] (Tier 1)
    □inv: is_sorted(registry_entries) ∧ ∀uri : unique(uri)
    □inv: ∀msg ∈ routed_messages : sender_has_role(msg, required_role)
    □inv: ∀msg ∈ routed_messages : transfer_ownership(msg.resources)
    @search: complexity == O(log N)

  [HAL] (Tier 1)
    □inv: ∀isr ∈ InterruptHandlers : only_sets_flag(isr) ∧ wakes_task(isr)
    □inv: ∀access : access_via_ipc_router(access) ∧ ¬direct_function_call(access)
    @safety: interrupt_occurred() ⇒ ◇(task_polls_flag() ∧ task_processes_in_own_context())

  [Memory-Manager] (Tier 2)
    □inv: total_allocated_bytes <= FB_CONF_MEMORY_POOL_SIZE
    □inv: ∃!owner ∈ Tasks : owns(owner, shm_id)
    @lifecycle: shm.release() ⇒ ¬caller_owns(shm) ∧ shm.claim() ⇒ new_owner_owns(shm)

  [JIT-Compiler] (Tier 2)
    □inv: ∀template ∈ InstructionTemplates : is_position_independent(template)
    □inv: active_cache_size + old_cache_size <= MAX_CACHE_SIZE
    □inv: ∀entry ∈ jit_entries : entry.pc_offset is_sorted
    @hotspot: process_compile() ⇒ ∀pc ∈ queue : lookup(pc) != NULL ∨ state(pc) == HOT

  [COOS] (Tier 2)
    □inv: matches_pattern(StatelessInterface) ∧ matches_pattern(Harness)

  [Scheduler] (Tier 3)
    □inv: ∀t ∈ tasks : t.state ∈ {READY, RUNNING, BLOCKED, INTERRUPTED}
    □inv: ∃!t : t.state == RUNNING ∨ (∀t : t.state != RUNNING)
    @liveness: ∀t ∈ blocked : (timeout(t) ∨ event(t)) ⊳ t.state == READY

  [Interpreter] (Tier 3)
    □inv: execution_context is_shared_with(JIT)
    □inv: stack_usage <= configured_stack_size
    @step: run_step(ctx) ⇒ (ctx.pc == next_pc) ∨ (ctx.trap != NONE)

  [WASM-Loader] (Tier 3)
    □inv: ∀view ∈ module_views : view.data points_to_rom ∧ ¬is_copied_to_ram(view)
    @verify: load(binary) ⇒ verify(Magic, Version, Boundaries) == PASS

  [Debugger] (Tier 3)
    □inv: state == DISABLED ⇒ overhead == 0
    □inv: state == STOPPED ⇒ ∀cmd ∈ command_queue : process(cmd)

  [vMMIO] (Tier 3)
    □inv: ∀addr : is_permitted(addr) ⇔ ∃entry ∈ permission_table : entry.range covers addr
    □inv: static_regions are_fixed_at_compile_time
    @access: guest_access(addr) ∧ ¬is_permitted(addr) ⇒ trap(ACCESS_VIOLATION)

[Prohibition-Crossref]
  @ref: .agent/brain/navigation_dispatch.atc
  - std::vector, std::map, std::string, std::function, std::unique_ptr
  - void*, malloc/free, new/delete, try/catch, iostream, thread/future

[State]
  - updated: 2026-02-18
  - status: ACTIVE
