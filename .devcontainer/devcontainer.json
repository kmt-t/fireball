{
  "name": "cpp-cpp23-dev",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "developer",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/home/developer/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/developer/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.gemini,target=/home/developer/.gemini,type=bind,consistency=cached"
  ],
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-vscode.cpptools",
        "vadimcn.vscode-lldb",
        "mesonbuild.mesonbuild",
        "google.gemini-cli-vscode-ide-companion",
        "rooveterinaryinc.roo-code-nightly",
        "continue.continue",
        "bierner.markdown-mermaid"
      ]
    }
  }
}