# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Force LF for text files
*.py text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.wit text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.hxx text eol=lf
*.cxx text eol=lf
*.c text eol=lf
*.h text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.lock text eol=lf

# Windows specific scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.wasm binary
*.png binary
*.jpg binary
*.ico binary


