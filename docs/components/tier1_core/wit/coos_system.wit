package fireball:core@0.1.0;

/// COOS カーネルおよびコアコンポーネント共通型定義
interface types {
    /// タスク識別子 (0〜15)
    type task-id = u32;

    /// チャンネル識別子
    type channel-id = u32;

    /// スケジューラエラーカテゴリ
    enum scheduler-error {
        /// タスク上限超過
        task-capacity-exceeded,
        /// 重複タスクID
        duplicate-task,
        /// 存在しないタスクID
        task-not-found,
    }

    /// 協調スケジューラへ渡す汎用割り込みイベント
    /// ベクタ実装や物理アドレスを含まず、固定5ワードの原因情報だけを保持する
    record interrupt-event {
        vector-id: u32,
        source-id: u32,
        cause-code: u32,
        payload0: u32,
        payload1: u32,
    }

    /// ログレベル重要度
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
        fatal,
    }

    /// ログ出力結果
    enum log-status {
        /// 正常記録（または満杯時の最古上書き完了）
        success,
        /// トランスポートビジー（DMA転送中）
        transporter-busy,
    }
}

/// CSP 通信エンジン (co_csp) インターフェース
/// バッファを持たない純粋同期ランデブー通信（値スロット不在・ゼロコピー所有権移譲）
interface csp {
    use types.{channel-id};

    /// 同期ランデブー送信時のアクション結果
    enum channel-action {
        /// 相手タスク不在のため自タスクがサスペンド（ブロック）
        block,
        /// 相手タスクとランデブー成立（直接対称遷移）
        direct-switch,
        /// 連続ハンドオフ上限到達によるスケジューラ復帰（イールド）
        yield-to-scheduler,
    }

    /// 1チャネルあたりの待機方向
    enum wait-direction {
        none,
        send,
        recv,
    }

    /// チャネルの現在待機状態の問い合わせ
    get-channel-state: func(chan: channel-id) -> wait-direction;
}

/// COOS スケジューラ (os_scheduler) インターフェース
/// 協調型マルチタスク実行制御・アイドル検出・割り込み通知
interface scheduler {
    use types.{task-id, scheduler-error, interrupt-event};

    /// 実行権を自発的にスケジューラへ譲渡する
    yield-task: func();

    /// 汎用割り込みイベントをISRコンテキストから固定長FIFOへ投函する
    notify-interrupt: func(event: interrupt-event);

    /// アイドル時フックコールバックの登録（システムアイドル時のログフラッシュ等）
    trigger-idle: func();
}

/// システムロギング (runtime_logging.md、Tier 2) サブシステムインターフェース
/// 辞書参照（24-bit offset + スカラー引数）によるゼロアロケーション・遅延出力
interface logging {
    use types.{log-level, log-status};

    /// 辞書参照ログイベントをリングバッファに記録する
    /// offset: ROM辞書内の24-bitオフセット
    /// args: 最大4個のスカラー引数
    log-event: func(level: log-level, offset: u32, arg0: u32, arg1: u32, arg2: u32, arg3: u32) -> log-status;

    /// 蓄積されたログブロックを物理トランスポートへ一括排出する（アイドル時フック連携）
    flush: func() -> log-status;
}

/// COOS コアワールド
world coos-kernel {
    export csp;
    export scheduler;
    export logging;
}
