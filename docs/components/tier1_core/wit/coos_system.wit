package fireball:core@0.1.0;

/// COOS カーネルおよびコアコンポーネント共通型定義
interface types {
    /// タスク識別子 (0〜15)
    type task-id = u32;

    /// チャンネル識別子
    type channel-id = u32;

    /// メモリパーティションスライス（固定長事前確保ブロック）
    record partition-slice {
        base-address: u32,
        size-bytes: u32,
        owner-task: task-id,
    }

    /// 共有メモリスライスハンドル (16-bit: page_idx << 8 | slot_idx)
    record shm-handle {
        handle: u32,
        base-address: u32,
        size-bytes: u32,
        owner-task: task-id,
    }

    /// ランタイムインスタンス識別子
    type runtime-id = u32;

    /// ランタイム用バンプアロケータのアリーナハンドル
    type runtime-arena = u32;

    /// JITキャッシュアロケータの固定長リージョンハンドル
    type jit-cache-region = u32;

    /// メモリエラーカテゴリ
    enum memory-error {
        /// メモリ枯渇・パーティション不足
        out-of-memory,
        /// 不正な所有権・二重解放
        invalid-owner,
        /// アドレス境界超過
        out-of-bounds,
    }

    /// スケジューラエラーカテゴリ
    enum scheduler-error {
        /// タスク上限超過
        task-capacity-exceeded,
        /// 重複タスクID
        duplicate-task,
        /// 存在しないタスクID
        task-not-found,
    }

    /// 協調スケジューラへ渡す汎用割り込みイベント
    /// ベクタ実装や物理アドレスを含まず、固定5ワードの原因情報だけを保持する
    record interrupt-event {
        vector-id: u32,
        source-id: u32,
        cause-code: u32,
        payload0: u32,
        payload1: u32,
    }

    /// ログレベル重要度
    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
        fatal,
    }

    /// ログ出力結果
    enum log-status {
        /// 正常記録（または満杯時の最古上書き完了）
        success,
        /// トランスポートビジー（DMA転送中）
        transporter-busy,
    }
}

/// メモリマネージャ (co_mem) インターフェース
/// system_memory.md が定義する5プール（ホスト用ヒープ、タスクヒープ、共有メモリ用ヒープ、
/// ランタイム用バンプアロケータ、JITキャッシュアロケータ）を静的貸与・返却する
interface memory {
    use types.{task-id, runtime-id, runtime-arena, jit-cache-region, partition-slice, shm-handle, memory-error};

    // --- 1. ホスト用ヒープ ---

    /// ホスト用ヒープから任意サイズのブロックを確保する（システムコンテナ専用、汎用ヒープではない）
    host-alloc: func(size-bytes: u32) -> result<u32, memory-error>;

    /// ホスト用ヒープのブロックを個別に解放する
    host-free: func(addr: u32) -> result<_, memory-error>;

    // --- 2. タスクヒープ ---

    /// COOS がタスクを起動する際に、タスク固有の静的メモリパーティションを貸与する
    acquire-task-heap: func(owner: task-id) -> result<partition-slice, memory-error>;

    /// タスク終了時に、貸与されたパーティションを返却する
    release-task-heap: func(owner: task-id) -> result<_, memory-error>;

    // --- 3. 共有メモリ用ヒープ ---

    /// IPC データ転送用の共有メモリスライスを割り当てる（呼出元タスクが初期所有者）
    allocate-shared: func(size-bytes: u32) -> result<shm-handle, memory-error>;

    /// IPC 経由で移譲された共有メモリの所有権を自タスクへ確立（Grant）する
    claim: func(handle: u32) -> result<shm-handle, memory-error>;

    /// 共有メモリスライスを解放しプールへ返却する（所有者タスクのみ実行可能）
    release: func(handle: u32) -> result<_, memory-error>;

    // --- 4. ランタイム用バンプアロケータ ---

    /// ランタイムインスタンスに専用のバンプアロケータアリーナを貸与する（1ランタイム1アリーナ）
    acquire-runtime-arena: func(runtime: runtime-id) -> result<runtime-arena, memory-error>;

    /// アリーナ内で固定長データを一括確保方向へ切り出す
    bump-alloc: func(arena: runtime-arena, size-bytes: u32) -> result<u32, memory-error>;

    /// アリーナ内の全確保を個別解放なしで O(1) 一括リセットする
    reset-runtime-arena: func(arena: runtime-arena);

    /// ランタイム終了時に、アリーナ全体をプールへ返却する
    release-runtime-arena: func(arena: runtime-arena);

    // --- 5. JITキャッシュアロケータ ---

    /// JIT コード生成専用の固定長リージョン（FB_CONF_JIT_CACHE_SIZE）を貸与する
    /// バンク分割・世代交代ローテーションは JIT サブシステム（jit_runtime.md）の管轄
    acquire-jit-cache: func() -> result<jit-cache-region, memory-error>;
}

/// CSP 通信エンジン (co_csp) インターフェース
/// バッファを持たない純粋同期ランデブー通信（値スロット不在・ゼロコピー所有権移譲）
interface csp {
    use types.{channel-id};

    /// 同期ランデブー送信時のアクション結果
    enum channel-action {
        /// 相手タスク不在のため自タスクがサスペンド（ブロック）
        block,
        /// 相手タスクとランデブー成立（直接対称遷移）
        direct-switch,
        /// 連続ハンドオフ上限到達によるスケジューラ復帰（イールド）
        yield-to-scheduler,
    }

    /// 1チャネルあたりの待機方向
    enum wait-direction {
        none,
        send,
        recv,
    }

    /// チャネルの現在待機状態の問い合わせ
    get-channel-state: func(chan: channel-id) -> wait-direction;
}

/// COOS スケジューラ (os_scheduler) インターフェース
/// 協調型マルチタスク実行制御・アイドル検出・割り込み通知
interface scheduler {
    use types.{task-id, scheduler-error, interrupt-event};

    /// 実行権を自発的にスケジューラへ譲渡する
    yield-task: func();

    /// 汎用割り込みイベントをISRコンテキストから固定長FIFOへ投函する
    notify-interrupt: func(event: interrupt-event);

    /// アイドル時フックコールバックの登録（システムアイドル時のログフラッシュ等）
    trigger-idle: func();
}

/// システムロギング (runtime_logging.md、Tier 2) サブシステムインターフェース
/// 辞書参照（24-bit offset + スカラー引数）によるゼロアロケーション・遅延出力
interface logging {
    use types.{log-level, log-status};

    /// 辞書参照ログイベントをリングバッファに記録する
    /// offset: ROM辞書内の24-bitオフセット
    /// args: 最大4個のスカラー引数
    log-event: func(level: log-level, offset: u32, arg0: u32, arg1: u32, arg2: u32, arg3: u32) -> log-status;

    /// 蓄積されたログブロックを物理トランスポートへ一括排出する（アイドル時フック連携）
    flush: func() -> log-status;
}

/// COOS コアワールド
world coos-kernel {
    export memory;
    export csp;
    export scheduler;
    export logging;
}
