package fireball:host@0.1.0;

/// 共通リカバリー戦略とエラー型定義
interface types {
    /// 障害時のリカバリー戦略カテゴリ
    enum recovery-strategy-category {
        /// エラーを無視して処理を継続
        ignore,
        /// 同一パラメータによる再試行
        retry,
        /// モジュールまたはシステムの再初期化が必要
        restart,
        /// 致命的エラー（システム停止・ダンプ）
        panic,
    }

    /// 基本操作結果型
    type operation-result = result<_, recovery-strategy-category>;
    /// モジュールロード結果型
    type load-result = result<_, recovery-strategy-category>;
    /// サービス登録結果型
    type registration-result = result<_, recovery-strategy-category>;
    /// IPCルーティング結果型
    type routing-result = result<_, recovery-strategy-category>;

    /// 共有メモリ（SHM）スライス定義
    record shm-slice {
        handle: u32,
        offset: u32,
        len: u32,
    }
}

/// WASI 0.3p / IPC 動的インターフェース取得・共有メモリ解決 (URI Resolver)
interface resolver {
    use types.{shm-slice, operation-result, recovery-strategy-category};

    /// IPC 宛先 URI (e.g. "fireball://device/uart/0", "fireball://device/gpio/0", "fireball://device/timer/0", "fireball://device/i2c/0", "fireball://service/stdout/0") から通信チャネルハンドルを取得
    get-interface: func(uri: string) -> result<u32, recovery-strategy-category>;
    /// 共有メモリ（SHM）バッファの確保
    acquire-shm: func(size-bytes: u32) -> result<shm-slice, recovery-strategy-category>;
    /// 共有メモリ（SHM）バッファの解放
    release-shm: func(slice: shm-slice) -> operation-result;
}

/// 高速トリガ (GPIO / fireball:hal/gpio 準拠) インターフェース
interface trigger {
    use types.{operation-result, recovery-strategy-category};

    set-pin: func(pin: u32, value: bool) -> operation-result;
    get-pin: func(pin: u32) -> result<bool, recovery-strategy-category>;
}

/// タイマー (wasi:clocks/monotonic-clock 準拠) インターフェース
interface timer {
    resource periodic-timer {
        get-now: func() -> u64;
        subscribe-timer: func(nanos: u64) -> u32;
    }
}

/// バス通信 (I2C/SPI マスタ・スレーブ / 共有メモリゼロコピー転送) インターフェース
interface bus {
    use types.{shm-slice, operation-result, recovery-strategy-category};

    resource bus-master {
        transfer-data: func(tx-buf: shm-slice, rx-buf: shm-slice) -> result<u32, recovery-strategy-category>;
    }

    resource bus-slave {
        set-response: func(data: shm-slice) -> operation-result;
        get-received: func(dest-buf: shm-slice) -> result<u32, recovery-strategy-category>;
        subscribe: func() -> u32;
    }
}

/// ストリーミング I/O (wasi:io/streams 準拠 / 共有メモリリードライト) インターフェース
interface streaming {
    use types.{shm-slice, recovery-strategy-category};

    resource streaming-master {
        write-stream: func(data: list<u8>) -> u32;
        write-shm: func(slice: shm-slice) -> result<u32, recovery-strategy-category>;
    }

    resource streaming-slave {
        read-stream: func(max-bytes: u32) -> list<u8>;
        read-shm: func(dest-slice: shm-slice) -> result<u32, recovery-strategy-category>;
    }
}

/// コンソール生バイト出力 (wasi:cli/stdout, stderr 準拠) インターフェース
interface console {
    use types.{recovery-strategy-category};

    resource console-output {
        write: func(data: list<u8>) -> result<u32, recovery-strategy-category>;
    }
}

/// 低レベル・トラップ・インターフェース
interface trap {
    fireball-call: func(id: u32, arg0: u32, arg1: u32, arg2: u32, arg3: u32, arg4: u32, arg5: u32) -> u32;
}

/// Fireball ハイパーバイザ Host World (HAL = WASI 0.3p Core World)
world fireball {
    import types;
    import resolver;
    import trigger;
    import timer;
    import bus;
    import streaming;
    import console;
    import trap;

    export resolver;
    export trigger;
    export timer;
    export bus;
    export streaming;
    export console;
}
