package fireball:host@0.1.0;

/// 共通リカバリー戦略とエラー型定義
interface types {
    /// 障害時のリカバリー戦略カテゴリ
    enum recovery-strategy-category {
        /// エラーを無視して処理を継続
        ignore,
        /// 同一パラメータによる再試行
        retry,
        /// モジュールまたはシステムの再初期化が必要
        restart,
        /// 致命的エラー（システム停止・ダンプ）
        panic,
    }

    /// 基本操作結果型
    type operation-result = result<_, recovery-strategy-category>;
    /// モジュールロード結果型
    type load-result = result<_, recovery-strategy-category>;
    /// サービス登録結果型
    type registration-result = result<_, recovery-strategy-category>;
    /// IPCルーティング結果型
    type routing-result = result<_, recovery-strategy-category>;

    /// HALバッファプール（vMMIO/DYNAMIC）スライス定義
    record hal-buffer-slice {
        handle: u32,
        offset: u32,
        len: u32,
    }
}

/// WASI 0.3p / IPC 動的インターフェース取得・HALバッファ解決 (URI Resolver)
interface resolver {
    use types.{hal-buffer-slice, operation-result, recovery-strategy-category};

    /// IPC 宛先 URI (e.g. "fireball://device/uart/0", "fireball://device/gpio/0", "fireball://device/timer/0", "fireball://device/i2c/0", "fireball://service/stdout/0") から通信チャネルハンドルを取得
    get-interface: func(uri: string) -> result<u32, recovery-strategy-category>;
    /// HALバッファプール（vMMIO/DYNAMIC）バッファの確保
    acquire-buffer: func(size-bytes: u32) -> result<hal-buffer-slice, recovery-strategy-category>;
    /// HALバッファプール（vMMIO/DYNAMIC）バッファの解放
    release-buffer: func(slice: hal-buffer-slice) -> operation-result;
}

/// 低レベル・トラップ・インターフェース
interface trap {
    fireball-call: func(id: u32, arg0: u32, arg1: u32, arg2: u32, arg3: u32, arg4: u32, arg5: u32) -> u32;
}

/// Fireball ハイパーバイザ Host World (HAL = WASI 0.3p Core World)
///
/// GPIO・タイマー・バス・ストリーム・コンソール個別の WIT リソースは定義しない。
/// HAL = WASI 0.3p であるため、`resolver.get-interface(uri)` で対象デバイス/サービスを
/// 解決し、`acquire-buffer`/`release-buffer` で得た `hal-buffer-slice` に対して
/// IPC コマンドID（`hal_dispatch.md` §5.2 を正本とする）を発行することで、
/// あらゆる WASI 0.3p 相当の読み書き・バス転送・非同期通知（poll）を一本化して表現する。
world fireball {
    import types;
    import resolver;
    import trap;

    export resolver;
}
