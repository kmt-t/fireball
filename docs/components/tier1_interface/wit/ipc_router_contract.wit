package fireball:ipc@0.1.0;

/// IPC ルータ 共通型定義
interface types {
    /// システムセキュリティロール
    enum role {
        runtime,
        core-service,
        hal-uart,
        hal-stdout,
        hal-gpio,
        hal-timer,
        hal-i2c,
        hal-spi,
        debugger,
    }

    /// Key-Value ペア（IPC 通信の最小単位、最大8ペア）
    record kv-pair {
        /// 型スコープ (8-bit: 上位3ビット種別 + 下位5ビット型)
        type-scope: u8,
        /// 識別キー (24-bit: スコープ内で一意)
        key-id: u32,
        /// 属性値 (32-bit: 即値またはリソースオフセット)
        value: u32,
    }

    /// IPC 送信ステータス
    enum ipc-status {
        success,
        err-not-found,
        err-permission-denied,
        err-message-too-large,
        err-invalid-ownership,
        err-invalid-response,
    }

    /// 要求・応答で共有する固定長メッセージ。
    /// sender-id はゲスト入力を採用せず、COOS Scheduler の sender stamper が送信元 TCB から設定する。
    /// sender stamper と reply stamper はメッセージ本体および埋込みSHMを Revoke し、Scheduler が対象TCBで Grant/Claim する。
    /// response-code の 0xffffffff は応答待ちを表し、受信側が別の u32 値へ更新する。
    record ipc-message {
        sender-id: u32,
        response-code: u32,
        entries: list<kv-pair>,
    }
}

/// IPC ルータ (ipc_router) インターフェース
/// 階層URIルーティング・RBACアクセス制御・所有権移譲
/// 呼び出し元の権限ロール（sender_role / receiver_role）は、偽装防止のため
/// スケジューラが現在実行中の TCB（Task Control Block）から暗黙的・確定的に取得される。
interface router {
    use types.{role, kv-pair, ipc-status};

    /// WASMサービスまたはHALサブシステム固有のURIと、それを処理するチャネルおよびロールを関連付けて登録する
    register-service: func(uri: string, service-role: role, channel: u32) -> ipc-status;

    /// 登録済みWASMサービス/HALエンドポイントのURIからチャネルハンドルを解決する（現在実行中タスクのロールでRBAC検証）
    lookup-service: func(uri: string) -> result<u32, ipc-status>;

    /// 宛先チャネルへ要求を送り、受信側の応答まで送信側をブロックする
    route-message: func(channel: u32, message: ipc-message) -> result<ipc-message, ipc-status>;

    /// 自タスクのロール宛てに許可された全エッジからメッセージを受信する
    receive-message: func() -> result<ipc-message, ipc-status>;

    /// 応答コードを設定した同一メッセージを送信元へ返す。entries の変更はそのまま応答データになる。
    reply-message: func(message: ipc-message) -> ipc-status;
}

/// IPC ルータ ワールド
world ipc-router {
    export router;
}
