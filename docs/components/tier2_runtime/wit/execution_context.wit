package fireball:interpreter@0.1.0;

/// インタープリタ/JIT 共通の統一スタックフレーム構造体群。
/// 正本: docs/components/tier2_runtime/runtime_interpreter.md 3.3
/// 物理配置（バイトオフセット）: docs/architecture/architecture_overview.md 3.3
interface unified-stack {
    /// スタックボトム（R1: stack_bot）に常駐する実行コンテキスト。計16バイト。
    record execution-context {
        /// オペランドスタック頂点オフセット。[R1, #0x00]
        sp-offset: u32,
        /// アクティブな call-frame のスタックボトム相対開始オフセット。[R1, #0x04]
        frame-offset: u32,
        /// 統合スタック最大許容オフセット（スタックオーバーフロー検知上限）。[R1, #0x08]
        sp-boundary: u32,
        /// 使用中のオプコードハンドラテーブル（通常用/デバッグ用）への参照。[R1, #0x0C]
        handler-table: u32,
    }

    /// 関数呼び出し時に統合スタック上へインラインで積まれるフレーム。計20バイト。
    /// フィールドはフレーム先頭からの相対オフセット（絶対位置は呼び出し深さごとに異なる）。
    record call-frame {
        /// 呼び出し元（親）コールフレームのスタックボトム相対オフセット。+0x00
        parent-frame-offset: u32,
        /// 関数終了後に戻るべきWASMバイトコードオフセット。+0x04
        return-pc: u32,
        /// このフレームのローカル変数配列の開始オフセット。+0x08
        local-var-offset: u32,
        /// 現在実行中の関数の管理番号。+0x0C
        function-index: u32,
        /// 関数呼び出し時点のスタック長（復元用）。+0x10
        saved-stack-len: u32,
    }

    /// block/loop/if 命令のネスト構造とジャンプ先を管理するフレーム。計16バイト。
    record control-frame {
        /// ブロックを抜ける際、またはループ先頭に戻る際のジャンプ先。+0x00
        label-pc: u32,
        /// ジャンプ先エントリポイント（JITコードまたはハンドラ）。exec_trace シグネチャ。+0x04
        exec-trace-ptr: u32,
        /// ブロック開始時点のスタック長。脱出時の復元に使用。+0x08
        saved-stack-len: u32,
        /// このブロックが戻す値の数（スタック Pruning に使用）。+0x0C
        result-arity: u16,
        /// 現在の構造が loop かどうか。+0x0E。+0x0F は4バイトアライメントのための予約バイト。
        loop-flag: u8,
    }
}
