package fireball:vsoc@0.1.0;

/// ゲスト実行環境の論理項目を表す。物理アドレスやexecution_context内の配置は定義しない。
/// {EnvironmentPointer} {VsocRuntime_Layout}
interface environment {
    /// ゲスト実行に必要なリニアメモリとglobal領域の論理ビュー。
    record vsoc-runtime {
        /// ゲストから見たリニアメモリ基点。
        mem-base: u32,
        /// リニアメモリの有効バイト数。
        mem-size: u32,
        /// global値領域の開始位置。
        globals-base: u32,
        /// global値領域の終端位置。
        globals-limit: u32,
    }
}

/// vSoC 仮想実行制御インターフェース
/// ゲスト実行制御・COOS協調境界・原因付き割り込みイベント配送
interface execution {
    /// vSoC 実行状態
    enum vsoc-state {
        stopped,
        running,
        paused,
        breakpoint-hit,
        trapped,
    }

    /// COOSから渡された汎用割り込みイベントをCOOS協調境界で配送する
    record interrupt-event {
        vector-id: u32,
        source-id: u32,
        cause-code: u32,
        payload0: u32,
        payload1: u32,
    }

    /// vIRQ階層へ原因イベントを渡す（WASI pollableとは別経路）
    dispatch-interrupt-event: func(event: interrupt-event);

    /// 現在の実行状態を取得
    get-execution-state: func() -> vsoc-state;
}

/// vSoC デバッガ・プロファイラ連携インターフェース
interface debug {
    /// ブレークポイント設定・解除
    set-breakpoint: func(pc: u32) -> bool;
    clear-breakpoint: func(pc: u32) -> bool;

    /// 実行時プロファイラサンプリング頻度の問い合わせ
    get-execution-count: func(pc: u32) -> u32;
}

/// vSoC ワールド
world vsoc-runtime {
    export environment;
    export execution;
    export debug;
}
