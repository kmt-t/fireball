package fireball:vsoc@0.1.0;

/// execution_context（R0: ctx）の +0x28〜+0x37 にインライン内包され、
/// 全ハンドラ・全JITトレースから直接アクセスされる、単一の呼び出しコンテキストを超えて生存する環境実体。
/// {EnvironmentPointer} {ExecutionContext_Layout} {VsocRuntime_Layout}
interface environment {
    /// vsoc-runtime: memory.grow で動的に伸長するリニアメモリの実体や、モジュール横断で
    /// 共有されるグローバル変数配列など、execution-context（R0）内に保持される環境状態。
    /// 計16バイト（execution-context オフセット +0x28〜+0x37）。
    record vsoc-runtime {
        /// ゲストリニアメモリの開始アドレス（memory.grow で再割当されうる）。+0x00 (+0x28)
        mem-base: u32,
        /// ゲストリニアメモリの現在の有効バイト数。FastAddressCheck の境界比較に直接使用（マスクは使わない）。+0x04 (+0x2C)
        mem-size: u32,
        /// WASM global 配列（4バイト単位でインデックス付け）の開始アドレス。+0x08 (+0x30)
        globals-base: u32,
        /// WASM global 配列の終端アドレス。+0x0C (+0x34)
        globals-limit: u32,
    }
}

/// vSoC 仮想実行制御インターフェース
/// ゲスト実行制御・Safepoint・原因付き割り込みイベント配送
interface execution {
    /// vSoC 実行状態
    enum vsoc-state {
        stopped,
        running,
        paused,
        breakpoint-hit,
        trapped,
    }

    /// COOSから渡された汎用割り込みイベントをSafepointで配送する
    record interrupt-event {
        vector-id: u32,
        source-id: u32,
        cause-code: u32,
        payload0: u32,
        payload1: u32,
    }

    /// vIRQ階層へ原因イベントを渡す（WASI pollableとは別経路）
    dispatch-interrupt-event: func(event: interrupt-event);

    /// 現在の実行状態を取得
    get-execution-state: func() -> vsoc-state;
}

/// vSoC デバッガ・プロファイラ連携インターフェース
interface debug {
    /// ブレークポイント設定・解除
    set-breakpoint: func(pc: u32) -> bool;
    clear-breakpoint: func(pc: u32) -> bool;

    /// 実行時プロファイラサンプリング頻度の問い合わせ
    get-execution-count: func(pc: u32) -> u32;
}

/// vSoC ワールド
world vsoc-runtime {
    export environment;
    export execution;
    export debug;
}
