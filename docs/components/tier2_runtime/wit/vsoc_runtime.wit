package fireball:vsoc@0.1.0;

/// exec_trace（インタープリタ/JIT共通の継続渡しシグネチャ）の第3引数（env: R2）として
/// 全ハンドラ・全JITトレースへ渡される、単一の呼び出しコンテキストを超えて生存する環境実体。
/// 正本: docs/components/tier2_runtime/runtime_vsoc.md 3.3
/// 物理配置（バイトオフセット）: docs/architecture/master_physical_design.md 3.2
interface environment {
    /// vsoc_runtime: memory.grow で動的に伸長するリニアメモリの実体や、モジュール横断で
    /// 共有されるグローバル変数配列など、execution_context（R1）より長く生存する状態を保持する。
    /// 計12バイト。
    record vsoc-runtime {
        /// ゲストリニアメモリの開始アドレス（memory.grow で再割当されうる）。+0x00
        mem-base: u32,
        /// ゲストリニアメモリの現在の有効バイト数。境界チェックに使用。+0x04
        mem-size: u32,
        /// WASM global 配列（4バイト単位でインデックス付け）の開始アドレス。+0x08
        globals-base: u32,
    }
}
