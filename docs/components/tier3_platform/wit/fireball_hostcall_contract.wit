package fireball:host@0.1.0;

/// 低レベル・ホストコール・インターフェース
interface trap {
    /// Fireball固有の高速ホスト呼び出し
    fireball-call: func(
        id: u32,
        arg0: u32,
        arg1: u32,
        arg2: u32,
        arg3: u32,
        arg4: u32,
        arg5: u32
    ) -> u32;
}

/// 仮想割り込みの登録・解除ホストコール
interface virq {
    /// 静的vIRQノードへのゲスト関数登録を保留する
    register: func(node-id: u32, function-index: u32) -> u32;
    /// 静的vIRQノードの登録解除を保留する
    unregister: func(node-id: u32) -> u32;
}

/// 仮想DMA転送ホストコール
interface vdma {
    /// ゲストまたはvMMIO管理下の領域間で転送を開始する
    start: func(source: u32, destination: u32, byte-count: u32) -> u32;
}

/// Fireball hostcall contract.
///
/// URI ResolverおよびHALバッファ操作は
/// `fireball_hal_contract.wit` に分離する。
world fireball-hostcall {
    import trap;
    import virq;
    import vdma;
}
