+          (func (param i32) (result i64)
+            local.get 0
+            if (result i64)
+              i64.const 1
+            else
+              f64.const 3 drop i32.const 4 i64.const 5 drop drop i64.const 6
+            end)
+          (func))"""
+        )
+    )
+    assert tuple(fn.max_operand_stack_words for fn in module.functions) == (5, 3, 0)
 
 
