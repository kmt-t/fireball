+@pytest.mark.parametrize("width", (254, 255, 256, 65535))
+def test_instruction_width_is_fixed_u16(width: int) -> None:
+    from tier2_runtime.interpreter.control_flow import build_interpreter_constant_pool
+
+    # For these counts the label-count LEB takes one, two, or three bytes.
+    count = width - (3 if width < 131 else 4 if width < 16388 else 5)
+    count_bytes = _encode_leb128_u32(count)
+    code = b"\x0e" + count_bytes + bytes(count + 1)
+    assert len(code) == width
+    pool, _ = build_interpreter_constant_pool(memoryview(code), (0,))
+    assert bytes(pool)[-2:] == width.to_bytes(2, "little")
+    assert len(pool) == (count + 2) * 4 + 2
+
+
+def test_loader_rejects_instruction_width_above_u16_and_rolls_back() -> None:
+    count = 65531
+    binary = wat_to_wasm(
+        '(module (func (export "main") (block (i32.const 0) (br_table '
+        + "0 " * (count + 1)
+        + "))))"
+    )
+    allocator = BumpAllocator(capacity=4 * 1024 * 1024)
+    allocator.allocate(8)
+    watermark = allocator.offset
+    with pytest.raises(InvalidWasm) as caught:
+        parse(memoryview(binary), allocator)
+    assert caught.value.code == TrapCode.INVALID_WASM_BINARY
+    assert allocator.offset == watermark
+
+
+def test_loader_records_maximum_operand_stack_in_raw_words() -> None:
+    module = parse(
