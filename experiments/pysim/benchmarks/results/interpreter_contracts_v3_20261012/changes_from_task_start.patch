+def build_peak_model(*, guards: bool = True) -> Kripke:
+    """型ごとの実ワード数と記録される高水位を別々に更新する。"""
+    actual_stack = []
+    recorded_stack = []
+    maximum = 0
+    states = [(0, 0, 0)]
+    labels = {states[0]: set()}
+    for phase, width in enumerate((1, 2, 2, -2, -2, -1), start=1):
+        if width > 0:
+            actual_stack.append(width)
+            recorded_stack.append(width if guards else 1)
+        else:
+            actual_stack.pop()
+            recorded_stack.pop()
+        actual = sum(actual_stack)
+        maximum = max(maximum, sum(recorded_stack))
+        state = (phase, actual, maximum)
+        states.append(state)
+        labels[state] = {"peak_underestimated"} if maximum < actual else set()
+    edges = list(pairwise(states))
+    edges.append((states[-1], states[-1]))
+    return Kripke(S=states, S0={states[0]}, R=edges, L=labels)
