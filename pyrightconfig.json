{
  "include": [
    "experiments/pysim/tier1_core/config.py",
    "experiments/pysim/tier1_core/interrupt_event.py",
    "experiments/pysim/tier1_core/printk.py",
    "experiments/pysim/tier2_runtime/observability/logging_interface.py",
    "experiments/pysim/tier1_interface/memory_interface.py",
    "experiments/pysim/tier2_runtime/wasm/opcodes.py"
  ],
  "exclude": [
    "**/__pycache__",
    "**/*.pyc",
    "experiments/pysim/tier2_runtime/*.pyx"
  ],
  "extraPaths": [
    "experiments/pysim",
    "experiments/pysim/tier1_core",
    "experiments/pysim/tier1_interface",
    "experiments/pysim/tier3_plugins/jit"
  ],
  "pythonVersion": "3.14",
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownVariableType": "none",
  "reportUnknownParameterType": "none",
  "reportUntypedFunctionDecorator": "none"
}
