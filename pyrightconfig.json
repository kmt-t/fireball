{
  "include": [
    "experiments/pysim/tier1_core/**/*.py",
    "experiments/pysim/tier1_interface/**/*.py",
    "experiments/pysim/__init__.py",
    "experiments/pysim/tier2_runtime/**/*.py",
    "experiments/pysim/system.py",
    "experiments/pysim/main.py",
    "experiments/pysim/tier3_plugins/**/*.py",
    "experiments/pysim/tier3_platform/**/*.py"
  ],
  "exclude": [
    "**/__pycache__",
    "**/*.pyc",
    "experiments/pysim/tier2_runtime/*.pyx"
  ],
  "extraPaths": [
    "experiments/pysim",
    "experiments/pysim/tier1_core",
    "experiments/pysim/tier1_interface",
    "experiments/pysim/tier3_plugins/jit"
  ],
  "pythonVersion": "3.14",
  "typeCheckingMode": "basic",
  "reportMissingImports": "error",
  "reportMissingTypeStubs": "none",
  "reportUnknownMemberType": "none",
  "reportUnknownArgumentType": "none",
  "reportUnknownVariableType": "none",
  "reportUnknownParameterType": "none",
  "reportUntypedFunctionDecorator": "none"
}
