package fireball:host;

interface coos-types {
    use types.{os-task-id, mem-address, sys-recovery-strategy};

    /// Task states in the cooperative scheduler.
    enum task-state-category {
        ready,
        running,
        blocked,
        interrupted,
        terminated
    }

    /// Task context managed by the kernel.
    /// @inv: id > 0 && id <= FB_CONF_MAX_TASKS
    record task-context-record {
        id: os-task-id,
        state: task-state-category,
        name: string,
    }
}

interface coos {
    use types.{os-task-id, mem-address, operation-result, sys-recovery-strategy, mem-shm-id, ipc-message, mem-byte-count};
    use coos-types.{task-state-category, task-context-record};

    /// Tier 2: Cooperative Task Scheduler
    /// @inv: current_task_id != 0 -> task_status[current_task_id] == running
    /// @inv: ready_queue_count <= FB_CONF_MAX_TASKS
    /// @constexpr: MAX_TASKS = FB_CONF_MAX_TASKS
    resource task-scheduler {
        /// Initializes the scheduler with required dependencies.
        /// @pre: !initialized
        /// @pre: memory is a valid base address
        /// @post: initialized
        init-scheduler: func(memory: mem-address) -> operation-result;

        /// Spawns a new task from a WASM entry point with priority.
        /// @pre: initialized
        /// @pre: name is not empty && entry != 0
        /// @post: result.is_ok() -> task_id > 0
        spawn: func(name: string, entry: mem-address, priority: u8) -> result<os-task-id, sys-recovery-strategy>;
        
        /// Yields execution to the next ready task.
        /// @pre: initialized
        /// @post: current_task transitions to ready state
        yield: func();

        /// Blocks the current task until a notification is received.
        /// @pre: initialized && current_task != 0
        /// @post: current_task transitions to blocked state
        wait: func() -> operation-result;

        /// Terminates the specified task.
        /// @pre: initialized && id is valid and active
        /// @post: task state == terminated
        terminate: func(id: os-task-id);
        
        /// Notifies the scheduler of an interrupt to wake up a task.
        /// @pre: initialized
        /// @post: task transitions to ready or interrupted state
        notify-interrupt: func(id: os-task-id);

        /// Gets information about a task.
        /// @pre: initialized
        get-task-info: func(id: os-task-id) -> result<task-context-record, bool>;

        /// Main scheduling loop.
        /// @pre: initialized
        run: func();
    }

    /// Tier 2: Hoare CSP Channel
    /// @inv: buffer_size <= FB_CONF_CHANNEL_SIZE
    resource ipc-channel {
        /// Sends a message block to the channel (blocks if no receiver).
        /// @pre: msg is valid
        /// @post: msg ownership transferred to channel or receiver
        send: func(msg: ipc-message) -> operation-result;

        /// Receives a message block from the channel (blocks if empty).
        /// @post: msg ownership transferred to caller
        receive: func() -> result<ipc-message, sys-recovery-strategy>;

        /// Gets channel usage information.
        get-channel-info: func() -> result<u32, bool>; // Returns active message count
    }

    /// Tier 2: Task-independent Memory Partition
    /// @inv: partition_size <= FB_CONF_TASK_HEAP_SIZE
    resource partition-memory {
        /// Allocates a block from the task's partition.
        /// @pre: size > 0
        /// @post: result.is_ok() -> allocated_bytes == old(allocated_bytes) + size
        allocate-block: func(size: mem-byte-count) -> result<mem-address, sys-recovery-strategy>;
        
        /// Frees a previously allocated block.
        /// @pre: ptr != 0
        /// @post: allocated_bytes == old(allocated_bytes) - size_of(ptr)
        deallocate-block: func(ptr: mem-address);
    }
}

world coos-world {
    export coos;
}
