package fireball:host;

interface guest-api {
    use types.{operation-result, shm-id};
    log: func(msg: shm-id);
    ipc-call: func(chan: u32, data: shm-id) -> operation-result;
}

world fireball-system {
    import types;
    import hal;
    import vsoc;
    import jit;
    import services;
    
    export guest-api;
}
