package fireball:host;

interface hal-types {
    use types.{hal-device-id, operation-result, sys-recovery-strategy, mem-byte-count};

    /// Hardware device categories.
    enum device-category {
        stream-device,
        block,
        trigger,
        timer
    }

    /// Configuration for the HAL buffer pool.
    record pool-setup-record {
        block-size: u32,
        block-count: u32,
    }

    /// Supported debug transport layers.
    enum debug-transport-category {
        uart,
        rtt
    }
}

interface hal {
    use types.{hal-device-id, mem-shm-id, operation-result, sys-recovery-strategy, mem-address, mem-byte-count, ipc-message};
    use hal-types.{device-category, pool-setup-record, debug-transport-category};

    /// Information about a physical device.
    record device-metadata-record {
        id: hal-device-id,
        kind: device-category,
        name: string,
        unit-size: mem-byte-count,
        reserved-pages: u32,
    }

    /// Information about an I/O buffer slot.
    record buffer-metadata-record {
        id: mem-shm-id,
        size: mem-byte-count,
        base: mem-address,
        is-active: bool,
    }

    /// Tier 1: Hardware Abstraction Layer Controller
    /// @inv: device_id < FB_CONF_HAL_MAX_DEVICES
    /// @inv: active_buffers <= FB_CONF_HAL_MAX_BUFFERS
    resource device-controller {
        /// Initializes the HAL.
        init-hal: func() -> operation-result;

        /// Reads data from a physical device into shared memory.
        /// @pre: id < FB_CONF_HAL_MAX_DEVICES
        /// @pre: dest != 0
        /// @post: result.is_ok() -> read_bytes <= dest.size
        read: func(id: hal-device-id, dest: mem-shm-id) -> result<u32, sys-recovery-strategy>;

        /// Writes data from shared memory to a physical device.
        /// @pre: id < FB_CONF_HAL_MAX_DEVICES
        /// @pre: src != 0
        write: func(id: hal-device-id, src: mem-shm-id) -> operation-result;

        /// Hardware specific control using Key-Value parameters.
        /// @pre: id < FB_CONF_HAL_MAX_DEVICES
        /// @param params Handle to a Key-Value message block.
        control: func(id: hal-device-id, cmd: u32, params: ipc-message) -> operation-result;

        /// Gets information about a device.
        get-device-info: func(id: hal-device-id) -> result<device-metadata-record, bool>;

        /// Gets information about a buffer.
        get-buffer-info: func(id: mem-shm-id) -> result<buffer-metadata-record, bool>;

        /// Acquires a fixed-size buffer for I/O.
        /// @pre: size <= FB_CONF_HAL_BUFFER_SIZE
        /// @post: result.is_ok() -> active_buffers == old(active_buffers) + 1
        acquire-buffer: func(size: u32) -> result<mem-shm-id, sys-recovery-strategy>;

        /// Releases an I/O buffer.
        /// @pre: id is valid and active
        /// @post: active_buffers == old(active_buffers) - 1
        release-buffer: func(id: mem-shm-id);
    }

    /// Tier 3: Physical GPIO / Interrupt Trigger
    resource gpio-controller {
        /// Sets the state of a physical pin.
        set-pin: func(pin: u32, value: bool) -> operation-result;

        /// Gets the state of a physical pin.
        get-pin: func(pin: u32) -> result<bool, sys-recovery-strategy>;
    }

    /// Tier 3: Hardware System Timer
    resource periodic-timer {
        /// Gets current system time in nanoseconds.
        get-now: func() -> u64;

        /// Sets an alarm interrupt at a specific time.
        subscribe-timer: func(nanos: u64) -> mem-shm-id; // Returns a pollable-like handle
    }

    /// Tier 3: Master/Slave Bus (I2C/SPI) - Zero Copy
    resource bus-master {
        /// Transfers data using shared memory buffers.
        /// @pre: tx_data and rx_data are valid shm_id
        transfer: func(tx-buffer: mem-shm-id, rx-buffer: mem-shm-id) -> operation-result;
    }

    resource bus-slave {
        /// Sets the response buffer for the next master read.
        set-response: func(buffer: mem-shm-id) -> operation-result;

        /// Gets the received buffer from the master write.
        get-received: func() -> result<mem-shm-id, sys-recovery-strategy>;
        
        /// Subscribes to bus events.
        subscribe: func() -> mem-shm-id;
    }

    /// Tier 3: Streaming Data I/O - Zero Copy
    resource streaming-master {
        /// Writes data from a shared memory buffer.
        write: func(buffer: mem-shm-id) -> operation-result;
    }

    /// Tier 3: Streaming Data I/O - Zero Copy
    resource streaming-slave {
        /// Reads data into a shared memory buffer.
        read: func(buffer: mem-shm-id) -> operation-result;
    }

    /// Tier 3: GDB RSP Debug Server
    resource debug-server {
        poll-packet: func() -> operation-result;
        get-parsed-command: func() -> result<mem-shm-id, sys-recovery-strategy>;
    }
}

world hal-world {
    export hal;
}
