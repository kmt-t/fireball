package fireball:host;

interface poll {
    /// A resource that can be polled for readiness.
    resource pollable {
        /// Returns true if the resource is ready.
        ready: func() -> bool;
        /// Blocks until the resource is ready.
        block: func();
    }
}

interface streams {
    use types.{recovery-strategy};
    use poll.{pollable};

    /// An input byte stream.
    resource input-stream {
        /// Performs a non-blocking read.
        read: func(len: u64) -> result<list<u8>, recovery-strategy>;
        /// Performs a blocking read.
        blocking-read: func(len: u64) -> result<list<u8>, recovery-strategy>;
        /// Subscribes to readiness events for this stream.
        subscribe: func() -> pollable;
    }

    /// An output byte stream.
    resource output-stream {
        /// Performs a non-blocking write.
        write: func(data: list<u8>) -> result<_, recovery-strategy>;
        /// Performs a blocking write and flush.
        blocking-write: func(data: list<u8>) -> result<_, recovery-strategy>;
        /// Subscribes to readiness events for this stream.
        subscribe: func() -> pollable;
    }
}

/// High-responsiveness Trigger (GPIO) interface.
interface trigger {
    use types.{operation-result, recovery-strategy};

    /// Sets the output value of a physical pin.
    set-pin: func(pin: u32, value: bool) -> operation-result;
    /// Gets the current value of a physical pin.
    get-pin: func(pin: u32) -> result<bool, recovery-strategy>;
}

/// Timer and sleep services.
interface timer {
    use poll.{pollable};

    /// A timer instance.
    resource timer-handle {
        /// Returns the current monotonic time in nanoseconds.
        now: func() -> u64;
        /// Creates a pollable that resolves after the specified duration.
        subscribe-duration: func(nanos: u64) -> pollable;
    }
}

/// Master and Slave Bus communication (I2C, SPI, etc.)
interface bus {
    use types.{operation-result, recovery-strategy};
    use poll.{pollable};

    /// A bus master device.
    resource bus-master {
        /// Performs a synchronous transfer (write then read or simultaneous).
        transfer: func(tx-data: list<u8>, rx-len: u32) -> result<list<u8>, recovery-strategy>;
    }

    /// A bus slave device.
    resource bus-slave {
        /// Sets the response data for the next master read request.
        set-response: func(data: list<u8>) -> operation-result;
        /// Gets the data received from the last master write request.
        get-received: func() -> result<list<u8>, recovery-strategy>;
        /// Subscribes to bus access events (e.g. addressed as slave).
        subscribe: func() -> pollable;
    }
}

/// One-way streaming data transfer.
interface streaming {
    use streams.{input-stream, output-stream};

    /// A streaming data producer.
    resource streaming-master {
        /// Gets the output stream for sending data.
        get-output-stream: func() -> output-stream;
    }

    /// A streaming data consumer.
    resource streaming-slave {
        /// Gets the input stream for receiving data.
        get-input-stream: func() -> input-stream;
    }
}

world hal {
    import trigger;
    import timer;
    import bus;
    import streaming;
}
