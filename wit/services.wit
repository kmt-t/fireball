package fireball:host;

interface services-types {
    use types.{error-code};

    /// Key-Value pair for IPC communication.
    /// Total 64 bits: 32-bit Key (8-bit Type + 24-bit ID) + 32-bit Value.
    record kv-pair {
        /// 8-bit Type Scope + 24-bit Key ID.
        key: u32,
        /// 32-bit Attribute Value or Resource Handle.
        value: u32,
    }

    /// IPC Message consisting of multiple KV pairs.
    type message = list<kv-pair>;
}

interface coos {
    use types.{error-code};

    /// Task management and scheduling.
    resource task-manager {
        /// Spawns a new task.
        spawn: func(entry-index: u32, memory-size: u32) -> result<u32, error-code>;
        /// Yields execution to the next task.
        yield: func();
        /// Exits the current task.
        exit: func(code: u32);
        /// Notifies an interrupt arrival for a specific task.
        notify-interrupt: func(task-id: u32);
    }
}

interface ipc {
    use types.{status, error-code};
    use services-types.{message};

    /// Service discovery and message routing.
    resource ipc-router {
        /// Registers a service URI.
        register-service: func(uri: string, role: u32, channel-id: u32) -> status;
        /// Looks up a service channel by URI.
        lookup-service: func(uri: string) -> result<u32, error-code>;
        /// Routes a message to a channel.
        route-message: func(channel-id: u32, msg: message) -> status;
    }
}

interface manager {
    use types.{status};

    /// High-level service lifecycle management.
    resource service-manager {
        /// Loads a service by URI.
        load-service: func(uri: string) -> status;
        /// Unloads a service by URI.
        unload-service: func(uri: string) -> status;
    }
}

world services {
    import coos;
    import ipc;
    import manager;
}
