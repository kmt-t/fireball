package fireball:host;

interface services-types {
    use types.{uri-handle, channel-id, task-id, service-id, kv-pair, operation-result, recovery-strategy, log-level, shm-id, message};
}

interface logger {
    use types.{log-level, operation-result};

    /// Tier 3: Logging Engine
    /// @inv: buffer_size is power of 2
    resource engine {
        /// Records an event using dictionary offset and arguments.
        /// @pre: dict_offset is valid within the ROM dictionary
        log-event: func(level: log-level, dict-offset: u32, arg0: u32, arg1: u32, arg2: u32, arg3: u32);

        /// Flushes the internal ring buffer to physical transport.
        /// @post: buffer is empty
        flush: func();
        
        /// Sets the minimum log level for physical output.
        set-threshold: func(level: log-level);
    }
}

interface services {
    use types.{uri-handle, channel-id, task-id, service-id, kv-pair, operation-result, recovery-strategy, log-level, shm-id, message};
    use logger.{engine as logger-engine};

    /// Tier 1: URI-based Message Router
    /// @inv: registry_count <= FB_CONF_ROUTER_MAX_SERVICES
    resource ipc-router {
        /// Binds a service instance by its system index.
        /// @pre: sid < FB_CONF_ROUTER_MAX_SERVICES
        bind: func(sid: service-id, address: uri-handle) -> result<channel-id, recovery-strategy>;

        /// Connects to a service and gets its system-wide ID.
        /// @pre: uri_handle is not empty
        connect: func(address: uri-handle) -> result<service-id, recovery-strategy>;

        /// Sends a Key-Value message block.
        /// @pre: chan >= 100
        send: func(chan: channel-id, msg: message) -> operation-result;

        /// Receives a Key-Value message block.
        recv: func(chan: channel-id) -> result<message, recovery-strategy>;
    }

    /// Tier 3: Logger Dictionary
    resource logger-dictionary {
        register-entry: func(id: u32, format: string);
        lookup: func(id: u32) -> result<string, bool>;
    }

    /// Tier 2: System-wide Logging Managed via Handle
    resource system-logger {
        /// Initializes logger with injected engine.
        /// @pre: engine is a valid resource handle
        /// @post: logger is ready for use
        initialize: func(engine: logger-engine) -> operation-result;

        /// Logs a message (delegates to engine).
        /// @pre: initialized
        log: func(level: log-level, dict-offset: u32, arg0: u32, arg1: u32, arg2: u32, arg3: u32);
    }
}

world services-world {
    export services;
}
