package fireball:host;

interface types {
    type device-id = u32;
    type shm-id = u32;
    type channel-id = u32;
    type task-id = u32;
    type uri-handle = shm-id;

    enum recovery-strategy {
        none,
        retry,
        component-reboot,
        system-panic
    }

    type operation-result = result<_, recovery-strategy>;

    enum log-level {
        trace,
        debug,
        info,
        warn,
        error,
        fatal
    }
}
