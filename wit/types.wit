package fireball:host;

interface types {
    /// Device identifier for HAL.
    type device-id = u32;

    /// Shared memory identifier.
    type shm-id = u32;

    /// Channel identifier for IPC.
    type channel-id = u32;

    /// Task identifier for OS.
    type task-id = u32;

    /// System-wide service identifier.
    type service-id = u32;

    /// Memory address.
    type address = u32;

    /// Byte count for memory sizes.
    type byte-count = u32;

    /// Byte offset from a base.
    type byte-offset = u32;

    /// Entry count for tables or arrays.
    type entry-count = u32;

    /// Instruction count for execution.
    type instruction-count = u32;

    /// Handle to a URI string.
    type uri-handle = u32;

    /// Binary view reference (read-only span).
    type binary-view = list<u8>;

    /// Binary view reference (read-write span).
    type mut-binary-view = list<u8>;

    /// Log level for system messages.
    enum log-level {
        debug,
        info,
        warn,
        error,
        fatal
    }

    /// Recovery strategy for operation failures.
    enum recovery-strategy {
        /// Error can be ignored, continue operation.
        ignore,
        /// Retry with same parameters may succeed.
        retry,
        /// Module or system needs to be re-initialized.
        restart,
        /// Fatal error, halt the system and dump state.
        panic
    }

    /// Result type for operations without success value.
    type operation-result = result<_, recovery-strategy>;

    /// Scope type for IPC messages (upper 3 bits of type_scope field).
    enum scope-type {
        functional,
        dictionary,
        reserved-2,
        reserved-3,
        reserved-4,
        reserved-5,
        reserved-6,
        reserved-7
    }

    /// Data type for IPC messages (lower 5 bits of type_scope field).
    enum data-type {
        immediate,
        handle,
        resource-id,
        constant-ref,
        reserved-4,
        reserved-5,
        reserved-6,
        reserved-7,
        reserved-8,
        reserved-9,
        reserved-10,
        reserved-11,
        reserved-12,
        reserved-13,
        reserved-14,
        reserved-15,
        reserved-16,
        reserved-17,
        reserved-18,
        reserved-19,
        reserved-20,
        reserved-21,
        reserved-22,
        reserved-23,
        reserved-24,
        reserved-25,
        reserved-26,
        reserved-27,
        reserved-28,
        reserved-29,
        reserved-30,
        reserved-31
    }

    /// IPC Key-Value pair for structured messaging.
    /// Bitfield layout: scope:8-bits (scope-type:3 + data-type:5), key:24-bits, value:32-bits
    /// @bitfield type_scope:u8:0-7, key:u24:8-31, value:u32:32-63
    record kv-pair {
        raw: u64,
    }

    /// IPC Message containing fixed maximum of 8 KV-pairs.
    record message {
        pairs: list<kv-pair>,
    }
}
