package fireball:host;

interface vsoc-types {
    use types.{address, operation-result, byte-count, recovery-strategy};

    /// Virtual machine configuration.
    record vm-config {
        ram-base: address,
        ram-size: byte-count,
        entry-point: address,
        /// Base physical address for PASSTHROUGH region mapping.
        /// physical_addr = passthrough-base + (guest_addr - passthrough_region_start)
        /// @note ARM Cortex-M: typically 0x4000_0000 (peripheral region)
        passthrough-base: address,
    }

    /// Execution states for the virtual machine.
    enum execution-state {
        ready,
        running,
        halted,
        trapped,
        interrupted
    }

    /// Identifiers for Virtual MMIO hooks.
    enum vmmio-hook-id {
        timer,
        uart,
        debug,
        reserved
    }

    /// Static 1:1 mapping entry: physical IRQ -> virtual IRQ ID.
    record irq-mapping-entry {
        physical-irq: u32,
        virtual-irq-id: u32,
    }
}

interface vsoc {
    use types.{operation-result, recovery-strategy, shm-id, address, byte-count, log-level, message, binary-view};
    use vsoc-types.{vm-config, execution-state, vmmio-hook-id, irq-mapping-entry};

    /// WASM Section Types (standard 0.2/1.0)
    enum wasm-section-type {
        custom,
        type-section,
        import-section,
        function-section,
        table-section,
        memory-section,
        global-section,
        export-section,
        start-section,
        element-section,
        code-section,
        data-section,
        data-count-section
    }

    /// Resource for reading WASM binary data from ROM with cursor management.
    resource binary-stream {
        /// Creates a stream from a binary view.
        from-view: static func(view: binary-view) -> binary-stream;

        /// Reads primitive types.
        read-u8: func() -> result<u8, bool>;
        read-s8: func() -> result<s8, bool>;
        read-u16: func() -> result<u16, bool>;
        read-s16: func() -> result<s16, bool>;
        read-u32: func() -> result<u32, bool>;
        read-s32: func() -> result<s32, bool>;
        read-u64: func() -> result<u64, bool>;
        read-s64: func() -> result<s64, bool>;

        /// Reads LEB128 encoded integers.
        read-leb128-u32: func() -> result<u32, bool>;
        read-leb128-s32: func() -> result<s32, bool>;
        read-leb128-u64: func() -> result<u64, bool>;
        read-leb128-s64: func() -> result<s64, bool>;
        
        /// Reads a block of data.
        read-bytes: func(len: byte-count) -> result<binary-view, bool>;

        /// Remaining bytes in the stream.
        remaining: func() -> byte-count;
    }

    /// View for a specific WASM module's section metadata.
    record wasm-section-view {
        id: wasm-section-type,
        data: binary-view,
    }

    /// Accessor for function-level metadata and instructions.
    resource wasm-function-accessor {
        /// Gets the function signature index.
        get-type-index: func() -> u32;

        /// Returns a stream for decoding local variables.
        get-locals-stream: func() -> binary-stream;

        /// Returns a stream for the bytecode instructions.
        get-code-stream: func() -> binary-stream;
    }

    /// Accessor for global variable metadata.
    resource wasm-global-accessor {
        /// Gets the value type and mutability.
        get-metadata: func() -> tuple<u8, bool>;

        /// Returns a stream for the initialization expression.
        get-init-expr-stream: func() -> binary-stream;
    }

    /// Tier 3: WASM Module View (Registry Entry Reference)
    /// @inv: module_id is unique
    resource wasm-module-view {
        /// Gets the raw ROM metadata for a specific section.
        get-section: func(stype: wasm-section-type) -> result<wasm-section-view, bool>;

        /// Lookups an exported function index by name.
        lookup-export-func: func(name: string) -> result<u32, bool>;

        /// Gets an accessor for a specific function.
        /// @pre: func_idx is valid
        get-function: func(func-idx: u32) -> result<wasm-function-accessor, bool>;

        /// Gets an accessor for a specific global.
        /// @pre: global_idx is valid
        get-global: func(global-idx: u32) -> result<wasm-global-accessor, bool>;
    }

    /// Tier 3: WASM Module Loader
    /// @inv: loaded_module_count <= FB_CONF_MAX_MODULES
    resource wasm-loader {
        /// Prepares a WASM module for execution from ROM.
        /// @pre: wasm is a valid binary_view in ROM
        /// @post: result.is_ok() -> module_view is valid
        /// @post: loaded_module_count incremented by 1
        prepare: func(wasm: binary-view) -> result<wasm-module-view, recovery-strategy>;
        
        /// Loads a module's linear memory into guest RAM.
        /// @pre: module is valid
        /// @post: initial memory pages allocated and initialized
        load: func(module: wasm-module-view) -> operation-result;

        /// Resolves cross-module imports by scanning import section and linking
        /// against exported symbols in the module_registry.
        /// @pre: module is loaded. All imported modules are already in registry.
        /// @post(ok): all imports resolved. Module is ready for execution.
        /// @post(err): unresolved import found. Module remains loaded but not executable.
        /// @derives: loader.md §4.1 Dependency Resolution
        resolve-imports: func(module: wasm-module-view) -> operation-result;

        /// Unloads a module and releases associated resources.
        /// @pre: module is in registry
        /// @post: module removed from registry. bump_allocator space reclaimed
        ///        if module was the last allocated (LIFO property of bump allocator).
        /// @note: Due to bump allocator LIFO constraint, full reclamation only
        ///        occurs when unloading in reverse order of loading.
        /// @derives: loader.md §4.2 state: Ready -> Idle: unload
        unload: func(module: wasm-module-view) -> operation-result;

        /// Lookups a loaded module from the registry.
        lookup: func(name: string) -> result<wasm-module-view, bool>;
    }

    /// Tier 3: Virtual MMIO Manager
    /// Unified access layer: ALL host-guest data exchange goes through vMMIO.
    /// Physical registers, shared memory, syscall buffers — everything.
    /// @inv: vmmio_base == FB_CONF_VMMIO_BASE
    /// @inv: security_gate == permission_table (single gate, no layering)
    resource vmmio-manager {
        /// Dispatches a trapped access to the appropriate handler.
        /// Permission table is checked first; permitted addresses get direct physical access.
        /// @pre: addr >= vmmio_base && addr < vmmio_base + vmmio_size
        /// @post: permitted(addr) => handler executed, result reflects register operation
        /// @post: !permitted(addr) => access violation trap
        dispatch-access: func(addr: address, buffer: list<u8>, is-write: bool) -> operation-result;

        /// Registers a host-side hook for a vMMIO region.
        /// @pre: handler-addr != 0
        register-hook: func(hook-id: vmmio-hook-id, handler-addr: address) -> operation-result;
        
        /// Reserves static regions in the DYNAMIC space.
        /// @pre: pages-count <= FB_CONF_VMMIO_DYNAMIC_PAGES
        reserve-static-regions: func(pages-count: u32);
    }

    /// Tier 2: vSoC Runtime
    /// @inv: ram_size == FB_CONF_GUEST_RAM_SIZE
    resource vsoc-runtime {
        /// Initializes the runtime environment with injected dependencies.
        /// @pre: !initialized
        /// @pre: loader, vmmio, memory are valid resource handles
        /// @post: initialized && dependencies are bound
        initialize: func(
            loader: wasm-loader,
            vmmio: vmmio-manager,
            memory: address,
            irq-mappings: list<irq-mapping-entry>
        ) -> operation-result;

        /// Steps execution until yield or trap.
        /// @pre: initialized
        /// @pre: state == running || state == halted
        /// @post: result.is_ok() -> state updated
        step: func() -> result<execution-state, recovery-strategy>;

        /// Notifies a virtual interrupt to the guest.
        /// @pre: initialized
        /// @pre: irq-id is valid
        notify-interrupt: func(irq-id: u32);
    }
}

world vsoc-world {
    export vsoc;
}
