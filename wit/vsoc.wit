package fireball:host;

interface vsoc-types {
    use types.{shm-id, address, byte-count};

    /// Configuration for a Virtual SoC instance.
    record vm-config {
        ram-size: byte-count,
        vmmio-base: address,
        vmmio-size: byte-count,
        jit-enabled: bool,
    }

    /// Execution state of the WASM guest.
    enum execution-state {
        halted,
        running,
        trapped,
        suspended
    }
}

interface vsoc {
    use types.{operation-result, recovery-strategy, shm-id, address, byte-count};
    use vsoc-types.{vm-config, execution-state};

    /// Tier 3: WASM Module Loader
    resource wasm-loader {
        /// Prepares a WASM module for execution.
        /// @pre: wasm_shm != 0
        /// @post: result.is_ok() -> module_id > 0
        prepare: func(wasm: shm-id) -> result<u32, recovery-strategy>;
    }

    /// Tier 3: Virtual MMIO Manager
    /// @inv: base_addr == FB_CONF_VMMIO_BASE
    resource vmmio-manager {
        /// Reads a 32-bit value from a virtual MMIO address.
        /// @pre: addr >= vmmio_base && addr < vmmio_base + vmmio_size
        access-read: func(addr: address) -> u32;

        /// Writes a 32-bit value to a virtual MMIO address.
        /// @pre: addr >= vmmio_base && addr < vmmio_base + vmmio_size
        access-write: func(addr: address, value: u32);
    }

    /// Tier 2: vSoC Runtime
    /// @inv: ram_size == FB_CONF_GUEST_RAM_SIZE
    /// @inv: state == running -> ram_handle != 0
    resource vsoc-runtime {
        /// Initializes the runtime environment.
        initialize: func() -> operation-result;

        /// Loads a WASM application into the runtime.
        /// @pre: wasm_handle != 0
        /// @post: state == halted
        load-app: func(wasm-handle: shm-id) -> operation-result;

        /// Background task for JIT processing.
        /// @pre: state != terminated
        process-jit: func();

        /// Runtime API: Log message from guest.
        /// @pre: msg_handle != 0
        api-log: func(msg-handle: shm-id);

        /// Runtime API: IPC Call from guest.
        /// @pre: data_handle != 0
        /// @post: result is consistent with IPC Router state
        api-ipc-call: func(chan: u32, data-handle: shm-id) -> operation-result;
    }
}

world vsoc-world {
    export vsoc;
}
