package fireball:host;

interface vsoc-types {
    use types.{shm-id};

    record vm-config {
        ram-size: u32,
        vmmio-base: u32,
        vmmio-size: u32,
        jit-enabled: bool,
    }

    record memory-region {
        base: u32,
        size: u32,
        shm-id: shm-id,
        readonly: bool,
    }

    enum execution-state {
        halted,
        running,
        trapped,
        suspended
    }
}

interface vsoc {
    use types.{operation-result, recovery-strategy, shm-id};
    use vsoc-types.{vm-config, memory-region, execution-state};

    /// Tier 2: Virtual SoC Instance Controller
    resource vsoc-instance {
        constructor(cfg: vm-config);
        execute: func() -> operation-result;
        step: func() -> operation-result;
        get-state: func() -> execution-state;
    }

    /// Tier 3: WASM Module Loader
    resource wasm-loader {
        prepare: func(wasm: shm-id) -> result<u32, recovery-strategy>;
        get-required-memory: func(module-id: u32) -> u32;
    }

    /// Tier 3: Virtual MMIO Dispatcher
    resource vmmio-manager {
        register-region: func(region: memory-region) -> operation-result;
        access-read: func(addr: u32) -> u32;
        access-write: func(addr: u32, value: u32);
    }
}

world vsoc-world {
    export vsoc;
}
